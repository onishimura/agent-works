@@ -1,12 +1,14 @@
 """Duration helpers. Durations are whole seconds (int)."""
 import re
 
-UNITS = {"h": 3600, "m": 60, "s": 1}
+# Each unit and its size in seconds, from the largest unit to the smallest.
+TABLE = (("h", 3600), ("m", 60), ("s", 1))
+UNITS = dict(TABLE)
 
 
 def parse_duration(text):
     """Parse "1h30m" to 5400. The units are h, m and s."""
-    parts = re.findall(r"(\d+)([hms])", text)
+    parts = re.findall(r"(\d+)([%s])" % "".join(UNITS), text)
     if "".join(n + u for n, u in parts) != text:
         raise ValueError("not a duration: %r" % text)
     return sum(int(n) * UNITS[u] for n, u in parts)
@@ -17,7 +19,7 @@ def format_duration(seconds):
     if seconds == 0:
         return "0s"
     parts = []
-    for unit, size in (("h", 3600), ("m", 60), ("s", 1)):
+    for unit, size in TABLE:
         if seconds >= size:
             parts.append("%d%s" % (seconds // size, unit))
             seconds %= size
